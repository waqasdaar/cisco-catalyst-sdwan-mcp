{
  "name": "catalyst-sdwan-mcp",
  "version": "1.0.0",
  "description": "MCP server for Cisco Catalyst SD-WAN Manager (vManage) API",
  "main": "build/index.js",
  "type": "module",
  "scripts": {
    "start": "node build/index.js",
    "build": "tsc",
    "deploy": "npm run build && node scripts/deploy.mjs",
    "dev": "tsx src/index.ts",
    "test": "node scripts/test-mock.mjs",
    "test:control-plane": "node scripts/test-control-plane.mjs",
    "test:ux2": "node scripts/test-ux2.mjs",
    "verify:api": "node scripts/verify-api-coverage.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.0.4",
    "dotenv": "^17.3.1",
    "undici": "^6.29.1"
