# Cisco Catalyst SD-WAN MCP Server
# Copy to .env and set your vManage credentials

# Required: vManage hostname or IP
VMANAGE_HOST=your-vmanage.example.com

# Required: vManage credentials (used for API authentication)
VMANAGE_USERNAME=admin
VMANAGE_PASSWORD=your_password

# Optional: Port (default 443 for HTTPS)
VMANAGE_PORT=443

# TLS: the Manager's certificate is verified on every connection.
# A self-signed certificate: pin it (npm run fingerprint prints it; check it before you trust it).
# VMANAGE_TLS_FINGERPRINT=AB:CD:...
# An internal CA: PEM file of the CA.
# VMANAGE_CA_FILE=/path/to/internal-ca.pem
# Labs only: accept any certificate (a warning is logged).
# VMANAGE_TLS_INSECURE=false

# Optional: Use JWT authentication (default true, recommended for vManage 20.18.1+)
# Set to false to use session-based (JSESSIONID) authentication
VMANAGE_USE_JWT=true

# Optional: allow call_api_operation to run write operations (POST/PUT/DELETE
# that change configuration or state). Default false = read-only.
VMANAGE_ALLOW_WRITE=false

# Optional: the AAA user password configuration groups set when deploy_template_migration moves a device
# from its device template (only needed when the group has an AAA password variable). Never sent to the assistant.
# VMANAGE_MIGRATION_AAA_PASSWORD=

# Optional: where deploy_template_migration keeps each device's migration state (masked, mode 600) and lock.
# Default ~/.local/state/cisco-catalyst-sdwan-mcp.
# VMANAGE_STATE_DIR=

# Optional: timeout in ms for real-time device queries (proxied to the device; can be slow). Default 120000.
VMANAGE_TIMEOUT_MS=120000

# Optional: timeout in ms for all other queries (inventory, configuration, statistics, login). Default 60000.
VMANAGE_LIST_TIMEOUT_MS=60000

# Optional: max simultaneous requests sent to vManage. Default 8.
VMANAGE_MAX_CONCURRENCY=8

# Optional: log each vManage call (path, status, duration, retries) to stderr. Default false.
VMANAGE_LOG_TIMING=false
