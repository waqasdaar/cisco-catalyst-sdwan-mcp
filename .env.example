# Cisco Catalyst SD-WAN MCP Server
# Copy to .env and set your vManage credentials

# Required: vManage hostname or IP
VMANAGE_HOST=your-vmanage.example.com

# Required: vManage credentials (used for API authentication)
VMANAGE_USERNAME=admin
VMANAGE_PASSWORD=your_password

# Optional: Port (default 443 for HTTPS)
VMANAGE_PORT=443

# Optional: Use JWT authentication (default true, recommended for vManage 20.18.1+)
# Set to false to use session-based (JSESSIONID) authentication
VMANAGE_USE_JWT=true

# Optional: allow call_api_operation to run write operations (POST/PUT/DELETE
# that change configuration or state). Default false = read-only.
VMANAGE_ALLOW_WRITE=false

# Optional: per-request timeout in ms (real-time device queries can be slow). Default 120000.
VMANAGE_TIMEOUT_MS=120000

# Optional: max simultaneous requests sent to vManage. Default 8.
VMANAGE_MAX_CONCURRENCY=8

# Optional: log each vManage call (path, status, duration, retries) to stderr. Default false.
VMANAGE_LOG_TIMING=false
